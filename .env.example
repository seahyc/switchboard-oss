# Optional connector environment. Keep secrets in a private environment file or
# secret manager; never commit credentials or session exports.

# Telegram values are used only when the Telegram connector is configured.
TG_APP_ID=
TG_APP_HASH=
TG_PHONE=
TG_SESSION_PATH=telegram.session
SWITCHBOARD_TG_BOT_TOKEN=

# The daemon administrator credential is normally stored at
# ~/.switchboard/api.token. Clients may use either of these:
# SWITCHBOARD_TOKEN=
# SWITCHBOARD_TOKEN_FILE=

# Optional newline-separated display names excluded from core-network results.
SWITCHBOARD_EXCLUDED_PEOPLE_NAMES=
# Whitespace-separated canonical bot/test chat IDs excluded by comprehension.
SWITCHBOARD_EXCLUDED_CHAT_IDS=
